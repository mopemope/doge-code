// Minimal codex-cli 0.172.0 app-server exchange (shapes from
// ../../../../dgc-daemon/tests/fixtures/codex/): mode `untrusted` must start the
// thread with approvalPolicy untrusted; one prompt, one reply "pong".
{"expect_args":["app-server"]}
{"expect":{"method":"initialize","id":"${ANY}"}}
{"capture":"init","path":"/id"}
{"send":{"id":"${init}","result":{"userAgent":"fake","platformFamily":"unix","platformOs":"linux"}}}
{"expect":{"method":"initialized"}}
{"expect":{"method":"thread/start","id":"${ANY}","params":{"approvalPolicy":"untrusted","sandbox":"workspace-write"}}}
{"capture":"thread","path":"/id"}
{"send":{"id":"${thread}","result":{"thread":{"id":"thr-cli-1"}}}}
{"expect":{"method":"turn/start","id":"${ANY}","params":{"threadId":"thr-cli-1"}}}
{"capture":"turn","path":"/id"}
{"send":{"id":"${turn}","result":{"turn":{"id":"turn-cli-1","status":"inProgress","error":null}}}}
{"send":{"method":"turn/started","params":{"threadId":"thr-cli-1","turn":{"id":"turn-cli-1","status":"inProgress","error":null}}}}
{"send":{"method":"item/completed","params":{"item":{"type":"agentMessage","id":"msg-cli-1","text":"pong"},"threadId":"thr-cli-1","turnId":"turn-cli-1"}}}
{"send":{"method":"turn/completed","params":{"threadId":"thr-cli-1","turn":{"id":"turn-cli-1","status":"completed","error":null}}}}
{"expect_eof":true}
