// Captures request_id and a nested value, echoes them, then requires the captured id.
{"expect":{"type":"control_request","request_id":"${ANY}"}}
{"capture":"rid","path":"/request_id"}
{"capture":"first","path":"/request/args/0"}
{"send":{"type":"control_response","response":{"request_id":"${rid}","id":"${first}"}}}
{"expect":{"echo":"${rid}"}}
