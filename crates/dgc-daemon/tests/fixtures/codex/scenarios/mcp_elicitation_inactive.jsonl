// SYNTHETIC: A tool approval with no turnId arrives after the turn completes.
// Derived from the Codex CLI 0.172.0 generated app-server schema and approval metadata.
{"expect_args":["app-server"]}
{"expect":{"method":"initialize","id":"${ANY}"}}
{"capture":"init","path":"/id"}
{"send":{"id":"${init}","result":{"userAgent":"codex/0.172.0"}}}
{"expect":{"method":"initialized"}}
{"expect":{"method":"thread/start","id":"${ANY}"}}
{"capture":"thread","path":"/id"}
{"send":{"id":"${thread}","result":{"thread":{"id":"thread-1"}}}}
{"expect":{"method":"turn/start","id":"${ANY}","params":{"threadId":"thread-1"}}}
{"capture":"turn","path":"/id"}
{"send":{"id":"${turn}","result":{"turn":{"id":"turn-1","status":"inProgress"}}}}
{"send":{"method":"turn/completed","params":{"threadId":"thread-1","turn":{"id":"turn-1","status":"completed"}}}}
{"send":{"method":"mcpServer/elicitation/request","id":0,"params":{"threadId":"thread-1","serverName":"dgc","mode":"form","message":"private elicitation text","requestedSchema":{"type":"object","properties":{}},"_meta":{"codex_approval_kind":"mcp_tool_call","tool_name":"create_agent","tool_params":{"prompt":"private tool arguments"}}}}}
{"expect":{"id":0,"result":{"action":"cancel","content":null}}}
{"exit":0}
